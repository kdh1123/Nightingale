{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightingale",
  "version": "0.1.0",
  "identifier": "com.nightingale.securitymonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Nightingale", "width": 1040, "height": 720, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "Utility",
    "shortDescription": "로컬 우선 방어형 보안 모니터",
    "longDescription": "Nightingale은 파일 활동과 시스템 상태를 분석해 설명 가능한 보안 신호를 제공하는 로컬 우선 보안 모니터입니다.",
    "copyright": "Copyright © 2026 Nightingale contributors",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
