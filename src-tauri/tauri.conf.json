{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightingale",
  "version": "0.1.0",
  "identifier": "com.nightingale.securitymonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Nightingale", "width": 1040, "height": 720, "minWidth": 800, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
